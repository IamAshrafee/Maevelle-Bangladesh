{
  "name": "maevelle-ecommerce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json --pretty false",
    "check:architecture": "node scripts/check-architecture.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres",
    "db:status": "docker compose ps postgres",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  }
}
