{
  "name": "maevelle-ecommerce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "build": "pnpm --filter @maevelle/admin build && pnpm --filter @maevelle/storefront build && tsc --build tsconfig.build.json --pretty false",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:hardening": "node scripts/check-hardening.mjs",
    "check:dependencies": "pnpm audit --prod --audit-level high",
    "backup:local": "node scripts/postgres-backup.mjs backup",
    "restore:drill": "node scripts/postgres-backup.mjs restore-drill",
    "check:release-readiness": "node scripts/release-readiness.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres",
    "db:status": "docker compose ps postgres",
    "db:migrate": "pnpm --filter @maevelle/database migrate",
    "db:migrate:status": "pnpm --filter @maevelle/database migrate:status",
    "bootstrap:owner": "pnpm --filter @maevelle/api bootstrap:owner",
    "dev:admin": "pnpm --filter @maevelle/admin dev",
    "dev:storefront": "pnpm --filter @maevelle/storefront dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  }
}
