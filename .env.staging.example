# ==============================================================================
# Maevelle Bangladesh — Staging Deployment Configuration
# ==============================================================================
# Never commit .env.staging. Generate all secret values uniquely for the staging host.
# Routine operational settings are managed via PostgreSQL-backed Settings inside Maevelle.
# ==============================================================================

STAGING_ENV_FILE=.env.staging.example

# 1. Database Infrastructure
POSTGRES_DB=maevelle_staging
POSTGRES_USER=maevelle_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD
DATABASE_URL=postgresql://maevelle_staging:REPLACE_WITH_STAGING_DATABASE_PASSWORD@postgres:5432/maevelle_staging
TEST_DATABASE_URL=postgresql://maevelle_staging:REPLACE_WITH_STAGING_DATABASE_PASSWORD@postgres:5432/maevelle_staging_test
DATABASE_POOL_MAX=10

# 2. Service Networking & Topology
LOG_LEVEL=info
CADDY_PORT=8080
STOREFRONT_BASE_URL=https://staging-storefront.example.invalid
STOREFRONT_INTERNAL_API_URL=http://api:3000

# 3. Authentication & Cryptographic Root Secrets
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
BETTER_AUTH_URL=https://staging.example.invalid

# 4. Storage Infrastructure
MEDIA_STORAGE_PATH=/app/var/media

# 5. External Provider Secrets (Deployment Managed)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SIGNING_SECRET

# 6. Initial Bootstrap Provisioning
BOOTSTRAP_OWNER_EMAIL=owner@staging.example.invalid
BOOTSTRAP_OWNER_PASSWORD=REPLACE_WITH_UNIQUE_STAGING_OWNER_PASSWORD
BOOTSTRAP_ORGANIZATION_CODE=maevelle-staging
BOOTSTRAP_ORGANIZATION_NAME=Maevelle Staging
ALLOW_STAGING_SEED=1

# 7. Optional Staging Fallbacks / Deployment Restrictions
# EMAIL_ENVIRONMENT=staging
# EMAIL_TEST_RECIPIENT_OVERRIDE=owner@staging.example.invalid
# EMAIL_ALLOWED_TEST_RECIPIENTS=owner@staging.example.invalid
