# Never commit .env.staging. Generate all secret values uniquely for the staging host.
STAGING_ENV_FILE=.env.staging.example
POSTGRES_DB=maevelle_staging
POSTGRES_USER=maevelle_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD
DATABASE_URL=postgresql://maevelle_staging:REPLACE_WITH_STAGING_DATABASE_PASSWORD@postgres:5432/maevelle_staging
TEST_DATABASE_URL=postgresql://maevelle_staging:REPLACE_WITH_STAGING_DATABASE_PASSWORD@postgres:5432/maevelle_staging_test
DATABASE_POOL_MAX=10
LOG_LEVEL=info
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
BETTER_AUTH_URL=https://staging.example.invalid
MEDIA_STORAGE_PATH=/app/var/media
MEDIA_MAX_UPLOAD_BYTES=10485760
CADDY_PORT=8080
