# ==============================================================================
# Maevelle Bangladesh — Deployment & Infrastructure Environment Configuration
# ==============================================================================
# This file contains ONLY Category A infrastructure, deployment secrets, network
# topologies, and bootstrap seeds.
#
# Routine operational and business settings (transactional email, sender identity,
# test recipients, media limits, storefront branding/URLs, business thresholds)
# are managed directly inside Maevelle through the Settings architecture
# (backed by PostgreSQL) and do not require .env changes or container redeployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Infrastructure (Category A - Deployment Managed)
# ------------------------------------------------------------------------------
# Local Docker Compose PostgreSQL credentials (development-only).
POSTGRES_DB=maevelle_dev
POSTGRES_USER=maevelle_dev
POSTGRES_PASSWORD=maevelle_dev_password
POSTGRES_TEST_DB=maevelle_test
POSTGRES_PORT=5434

# Authoritative connection strings and pool sizing.
DATABASE_URL=postgresql://maevelle_dev:maevelle_dev_password@localhost:5434/maevelle_dev
TEST_DATABASE_URL=postgresql://maevelle_dev:maevelle_dev_password@localhost:5434/maevelle_test
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 2. Service Networking & Topology (Category A - Infrastructure)
# ------------------------------------------------------------------------------
# Local bind address and port for the core Fastify API service.
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
WORKER_HEARTBEAT_INTERVAL_MS=30000

# Reverse proxy (Caddy) and public origin configuration.
CADDY_PORT=8080
STOREFRONT_BASE_URL=http://localhost:8080
STOREFRONT_INTERNAL_API_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Authentication & Root Cryptographic Secrets (Category A - Root of Trust)
# ------------------------------------------------------------------------------
# BetterAuth signing secret (minimum 32 random characters).
BETTER_AUTH_SECRET=replace-with-at-least-32-character-development-secret
BETTER_AUTH_URL=http://localhost:8080
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:3001

# Root encryption key (Base64-encoded 32-byte key) for AES-256-GCM.
# Used for encrypting integration secrets, tokens, and data at rest in PostgreSQL.
# MUST NEVER be committed to Git or stored inside the database.
AUTH_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ------------------------------------------------------------------------------
# 4. Storage Infrastructure (Category A - Deployment Managed)
# ------------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=var/media

# Cloudflare R2 / S3-compatible storage (Production / Staging):
# MEDIA_STORAGE_PROVIDER=s3
# MEDIA_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# MEDIA_STORAGE_REGION=auto
# MEDIA_STORAGE_ACCESS_KEY_ID=
# MEDIA_STORAGE_SECRET_ACCESS_KEY=
# MEDIA_PRIVATE_BUCKET=maevelle-prod-media-private
# MEDIA_PUBLIC_BUCKET=maevelle-prod-media-public
# MEDIA_STORAGE_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 5. External Provider Secrets (Category A / C - Deployment Fallbacks / Integrations)
# ------------------------------------------------------------------------------
# External provider API keys may be provided via deployment secrets or configured
# securely as encrypted integration secrets via Maevelle Settings APIs.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. First-Time Provisioning & Bootstrap (Category A - Initial Install Only)
# ------------------------------------------------------------------------------
# Used only during initial installation/seeding to provision the root tenant and owner.
# Subsequent management happens via IAM and settings within the application.
BOOTSTRAP_OWNER_EMAIL=owner@maevelle.local
BOOTSTRAP_OWNER_PASSWORD=Maevelle-dev-password-2026
BOOTSTRAP_ORGANIZATION_CODE=maevelle
BOOTSTRAP_ORGANIZATION_NAME=Maevelle Bangladesh
STOREFRONT_ORGANIZATION_CODE=maevelle

# ------------------------------------------------------------------------------
# 7. Optional Deployment Safety Controls & Fallbacks (Category A)
# ------------------------------------------------------------------------------
# Hard emergency killswitches or deployment safety policies.
# When omitted, Maevelle runtime settings in PostgreSQL govern operation dynamically.
# EMAIL_ENABLED=false
# EMAIL_ENVIRONMENT=development
# EMAIL_FROM_NAME=Maevelle
# EMAIL_FROM_ADDRESS=orders@example.invalid
# EMAIL_REPLY_TO=maevelleBangladesh@gmail.com
# EMAIL_TEST_RECIPIENT_OVERRIDE=
# EMAIL_ALLOWED_TEST_RECIPIENTS=
# MEDIA_MAX_UPLOAD_BYTES=10485760
# MEDIA_UPLOAD_EXPIRY_SECONDS=900
