# Local Docker Compose PostgreSQL only. These credentials are development-only.
POSTGRES_DB=maevelle_dev
POSTGRES_USER=maevelle_dev
POSTGRES_PASSWORD=maevelle_dev_password
POSTGRES_TEST_DB=maevelle_test
POSTGRES_PORT=5434

DATABASE_URL=postgresql://maevelle_dev:maevelle_dev_password@localhost:5434/maevelle_dev
TEST_DATABASE_URL=postgresql://maevelle_dev:maevelle_dev_password@localhost:5434/maevelle_test
DATABASE_POOL_MAX=10
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
WORKER_HEARTBEAT_INTERVAL_MS=30000
# Development-only values. Generate unique secrets for any shared/deployed environment.
BETTER_AUTH_SECRET=replace-with-at-least-32-character-development-secret
AUTH_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MEDIA_STORAGE_PATH=var/media
MEDIA_MAX_UPLOAD_BYTES=10485760
BETTER_AUTH_URL=http://localhost:8080
CADDY_PORT=8080
