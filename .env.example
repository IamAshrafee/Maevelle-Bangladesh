# Local Docker Compose PostgreSQL only. These credentials are development-only.
POSTGRES_DB=maevelle_dev
POSTGRES_USER=maevelle_dev
POSTGRES_PASSWORD=maevelle_dev_password
POSTGRES_TEST_DB=maevelle_test
POSTGRES_PORT=5434

DATABASE_URL=postgresql://maevelle_dev:maevelle_dev_password@localhost:5434/maevelle_dev
TEST_DATABASE_URL=postgresql://maevelle_dev:maevelle_dev_password@localhost:5434/maevelle_test
DATABASE_POOL_MAX=10
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
WORKER_HEARTBEAT_INTERVAL_MS=30000
CADDY_PORT=8080
