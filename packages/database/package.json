{
  "name": "@maevelle/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./dist/src/catalog.js"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./dist/src/media.js"
    },
    "./sizing": {
      "types": "./src/sizing.ts",
      "default": "./dist/src/sizing.js"
    },
    "./migrations": {
      "types": "./src/migrations/index.ts",
      "default": "./dist/src/migrations/index.js"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "default": "./dist/src/platform.js"
    },
    "./warehouse": {
      "types": "./src/warehouse.ts",
      "default": "./dist/src/warehouse.js"
    },
    "./inventory": {
      "types": "./src/inventory.ts",
      "default": "./dist/src/inventory.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json --pretty false",
    "migrate": "pnpm run build && node dist/src/migrate-cli.js",
    "migrate:status": "pnpm run build && node dist/src/migrate-cli.js --status"
  },
  "dependencies": {
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
