{
  "name": "@maevelle/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./dist/src/catalog.js"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./dist/src/media.js"
    },
    "./sizing": {
      "types": "./src/sizing.ts",
      "default": "./dist/src/sizing.js"
    },
    "./migrations": {
      "types": "./src/migrations/index.ts",
      "default": "./dist/src/migrations/index.js"
    },
    "./platform": {
      "types": "./src/platform.ts",
      "default": "./dist/src/platform.js"
    },
    "./warehouse": {
      "types": "./src/warehouse.ts",
      "default": "./dist/src/warehouse.js"
    },
    "./inventory": {
      "types": "./src/inventory.ts",
      "default": "./dist/src/inventory.js"
    },
    "./geography": {
      "types": "./src/geography.ts",
      "default": "./dist/src/geography.js"
    },
    "./customers": {
      "types": "./src/customers.ts",
      "default": "./dist/src/customers.js"
    },
    "./pricing": {
      "types": "./src/pricing.ts",
      "default": "./dist/src/pricing.js"
    },
    "./promotions": {
      "types": "./src/promotions.ts",
      "default": "./dist/src/promotions.js"
    },
    "./cart": {
      "types": "./src/cart.ts",
      "default": "./dist/src/cart.js"
    },
    "./orders": {
      "types": "./src/orders.ts",
      "default": "./dist/src/orders.js"
    },
    "./payments": {
      "types": "./src/payments.ts",
      "default": "./dist/src/payments.js"
    },
    "./fulfillment": {
      "types": "./src/fulfillment.ts",
      "default": "./dist/src/fulfillment.js"
    },
    "./delivery": {
      "types": "./src/delivery.ts",
      "default": "./dist/src/delivery.js"
    },
    "./procurement": {
      "types": "./src/procurement.ts",
      "default": "./dist/src/procurement.js"
    },
    "./costing": {
      "types": "./src/costing.ts",
      "default": "./dist/src/costing.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json --pretty false",
    "migrate": "pnpm run build && node dist/src/migrate-cli.js",
    "migrate:status": "pnpm run build && node dist/src/migrate-cli.js --status"
  },
  "dependencies": {
    "@maevelle/security": "workspace:*",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
